{
  "expo": {
    "name": "Bambu",
    "slug": "bambu",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon-bambu.png",
    "scheme": "bambu",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.mvks5.bambu",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDocumentTypes": [
          { "CFBundleTypeName": "3MF Model", "LSHandlerRank": "Owner", "LSItemContentTypes": ["com.bambulab.3mf"] },
          { "CFBundleTypeName": "Bambu Sliced 3MF", "LSHandlerRank": "Owner", "LSItemContentTypes": ["com.bambulab.gcode-3mf"] },
          { "CFBundleTypeName": "G-code", "LSHandlerRank": "Owner", "LSItemContentTypes": ["com.bambulab.gcode"] },
          { "CFBundleTypeName": "STL Model", "LSHandlerRank": "Alternate", "LSItemContentTypes": ["public.standard-tesselated-geometry-format"] }
        ],
        "UTImportedTypeDeclarations": [
          {
            "UTTypeIdentifier": "com.bambulab.3mf",
            "UTTypeDescription": "3MF Model",
            "UTTypeConformsTo": ["public.data", "public.zip-archive"],
            "UTTypeTagSpecification": {
              "public.filename-extension": ["3mf"],
              "public.mime-type": ["model/3mf", "application/vnd.ms-package.3dmanufacturing-3dmodel+xml"]
            }
          },
          {
            "UTTypeIdentifier": "com.bambulab.gcode-3mf",
            "UTTypeDescription": "Bambu Sliced 3MF",
            "UTTypeConformsTo": ["com.bambulab.3mf"],
            "UTTypeTagSpecification": { "public.filename-extension": ["gcode.3mf"] }
          },
          {
            "UTTypeIdentifier": "com.bambulab.gcode",
            "UTTypeDescription": "G-code",
            "UTTypeConformsTo": ["public.text", "public.data"],
            "UTTypeTagSpecification": {
              "public.filename-extension": ["gcode"],
              "public.mime-type": ["text/x.gcode"]
            }
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      "expo-secure-store",
      "expo-image",
      "./plugins/withIosSceneLifecycle",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ],
      "./plugins/withIosPodMinDeploymentTarget"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "11b5b76a-bb6f-40c6-98a6-3fbe33d4292b"
      }
    }
  }
}
