# Copy to .env-local (gitignored) — build settings that are yours, not the repo's.
# Apple Developer team id: Xcode → Settings → Accounts, or developer.apple.com → Membership.
DEVELOPMENT_TEAM=XXXXXXXXXX

# App Store Connect API key, for uploading a build to TestFlight with altool.
#
# Only needed to SHIP. Archiving and exporting an .ipa work without these.
#
# ASC_KEY_ID is the filename stem of ~/.appstoreconnect/private_keys/AuthKey_<KEY_ID>.p8. The .p8
# itself is the secret and stays in that directory — never in the repo, and it is not reproducible
# (Apple lets you download it exactly once).
# ASC_ISSUER_ID is the issuer UUID from App Store Connect → Users and Access → Integrations.
#
# altool is used rather than `-exportArchive -destination upload` because the Apple ID signed into
# Xcode has Developer-portal access (enough to regenerate provisioning profiles) but not App Store
# Connect access, so the built-in upload fails with "Failed to Use Accounts".
ASC_KEY_ID=XXXXXXXXXX
ASC_ISSUER_ID=00000000-0000-0000-0000-000000000000

# Manual export signing (optional). Leave these unset to export with AUTOMATIC signing, which is
# fine when the Apple ID signed into Xcode owns a cloud-managed distribution certificate.
#
# Set all three to export MANUALLY against your own distribution certificate + App Store profiles
# instead. This is the path when automatic export fails with "Cloud signing permission error" —
# e.g. an ASC API key that isn't authorized for cloud-managed distribution certs. The named
# profiles must already exist, be installed under ~/Library/MobileDevice/Provisioning Profiles, and
# carry every entitlement the app requests (App Attest included): after adding a capability to the
# App ID, regenerate the profile (developer.apple.com, Xcode, or the ASC API) before archiving.
#
# DIST_CERT is a codesigning identity name from `security find-identity -v -p codesigning`
# (e.g. "iPhone Distribution" or "Apple Distribution"); its private key must be in the keychain.
#DIST_CERT="iPhone Distribution"
#DIST_PROFILE_APP="Bambu AppStore CLI"
#DIST_PROFILE_WIDGET="Bambu LiveActivity AppStore CLI"
#
# The notification service extension's profile — the appex that draws a camera frame on a halt
# banner. It needs its own App ID, com.mvks5.bambu.Notify, with App Groups enabled and
# group.com.mvks5.bambu assigned, and then its own iOS App Store distribution profile.
#
# Leaving it unset is harmless on a build with no such appex. On one that HAS it, the export falls
# back to automatic signing rather than shipping an extension nobody signed.
#DIST_PROFILE_NOTIFY="Bambu Notify AppStore CLI"
