# Copy to .env-local (gitignored) — build settings that are yours, not the repo's.
# Apple Developer team id: Xcode → Settings → Accounts, or developer.apple.com → Membership.
DEVELOPMENT_TEAM=XXXXXXXXXX

# App Store Connect API key, for uploading a build to TestFlight with altool.
#
# Only needed to SHIP. Archiving and exporting an .ipa work without these.
#
# ASC_KEY_ID is the filename stem of ~/.appstoreconnect/private_keys/AuthKey_<KEY_ID>.p8. The .p8
# itself is the secret and stays in that directory — never in the repo, and it is not reproducible
# (Apple lets you download it exactly once).
# ASC_ISSUER_ID is the issuer UUID from App Store Connect → Users and Access → Integrations.
#
# altool is used rather than `-exportArchive -destination upload` because the Apple ID signed into
# Xcode has Developer-portal access (enough to regenerate provisioning profiles) but not App Store
# Connect access, so the built-in upload fails with "Failed to Use Accounts".
ASC_KEY_ID=XXXXXXXXXX
ASC_ISSUER_ID=00000000-0000-0000-0000-000000000000
