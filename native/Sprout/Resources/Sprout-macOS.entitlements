<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>

	<!-- Outbound to Bambuddy, which the owner self-hosts. Every request in the app goes through it. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Inbound. Bambuddy is usually on the LAN, and reaching a .local name needs Bonjour
	     resolution, which the sandbox treats as a server capability. Without this a hostname that
	     resolves fine in Safari fails inside the app, which reads as "the server is down". -->
	<key>com.apple.security.network.server</key>
	<true/>

	<!-- File import and export: the Add file… panel, Save frame…, and dragging a .3mf out of the
	     Files grid into Finder or a slicer. -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!-- Imports that land in the library folder without a panel — a MakerWorld import, or a file
	     dropped on the Dock icon. -->
	<key>com.apple.security.files.downloads.read-write</key>
	<true/>

	<!-- Shared with the iOS build and the widget. Kept on macOS because the camera snapshot path
	     writes frames into the group container. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.mvks5.bambu</string>
	</array>

	<!-- `aps-environment` and `com.apple.developer.devicecheck.appattest-environment` are
	     deliberately ABSENT, and this file used to declare both.
	     
	     The App ID has neither capability enabled for macOS, and Xcode's packaging step does not
	     refuse an entitlement the profile lacks — it SILENTLY FILTERS IT OUT. Verified on the
	     exported .pkg: the archive succeeded, the signature was valid, and the two keys were simply
	     gone. A file that asks for something it never receives is worse than one that does not ask,
	     because it reads as a guarantee.

	     Restoring them is: enable Push Notifications and App Attest for macOS on the App ID, put
	     the two keys back, and re-enable the registration call in MacAppDelegate. Until then macOS
	     has no remote notifications, which costs nothing today — nothing there consumes a token. -->
</dict>
</plist>
