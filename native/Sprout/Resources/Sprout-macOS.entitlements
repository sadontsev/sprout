<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>

	<!-- Outbound to Bambuddy, which the owner self-hosts. Every request in the app goes through it. -->
	<key>com.apple.security.network.client</key>
	<true/>
	<!-- Inbound. Bambuddy is usually on the LAN, and reaching a .local name needs Bonjour
	     resolution, which the sandbox treats as a server capability. Without this a hostname that
	     resolves fine in Safari fails inside the app, which reads as "the server is down". -->
	<key>com.apple.security.network.server</key>
	<true/>

	<!-- File import and export: the Add file… panel, Save frame…, and dragging a .3mf out of the
	     Files grid into Finder or a slicer. -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!-- Imports that land in the library folder without a panel — a MakerWorld import, or a file
	     dropped on the Dock icon. -->
	<key>com.apple.security.files.downloads.read-write</key>
	<true/>

	<!-- Shared with the iOS build and the widget. Kept on macOS because the camera snapshot path
	     writes frames into the group container. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.mvks5.bambu</string>
	</array>

	<!-- Remote notifications. **`com.apple.developer.aps-environment`, not `aps-environment`.**
	     
	     The bare `aps-environment` is the iOS spelling. macOS uses the prefixed one, and the two are
	     not interchangeable: the Mac profile grants only the prefixed key, so the iOS spelling is an
	     entitlement the profile does not contain — and Xcode does not refuse those, it SILENTLY
	     FILTERS THEM OUT. The archive succeeded, the signature was valid, and push was simply gone.
	     
	     That cost a wrong diagnosis: the App ID was blamed (it has PUSH_NOTIFICATIONS enabled and
	     always did) and the profile was blamed (it grants the capability and always did). Decoding
	     the profile and reading the key names is what settled it. Two names that look like synonyms
	     and are not — the same shape as `isSliced` vs `hasGcode`.
	     
	     Xcode rewrites `development` to `production` on an App Store export, as it does on iOS. -->
	<key>com.apple.developer.aps-environment</key>
	<string>development</string>

	<!-- App Attest is deliberately ABSENT on macOS, and this file used to declare it.
	     
	     The App ID has APP_ATTEST enabled, but the Mac provisioning profile does not carry it —
	     decoded and checked, `appattest=0` on both the development and store profiles, while
	     `aps=1` on both. Xcode's packaging step does not refuse an entitlement the profile lacks;
	     it SILENTLY FILTERS IT OUT, so the archive succeeds and the signature is valid with the key
	     simply gone. A file that asks for something it never receives reads as a guarantee.

	     Nothing on macOS needs it in any case: App Attest is used by `LiveActivityController` to
	     vouch push tokens to Canopy, and that whole file is `#if os(iOS)`. -->
</dict>
</plist>
