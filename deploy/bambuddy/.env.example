# Docker Hub publishes only :latest for the main image (the GHCR package is private).
# For production, pin by digest (record the running sha256 in docs/phase0-results.md).
BAMBUDDY_TAG=latest
TZ=Europe/London
# 8000 is taken by Portainer on <your-server>; Bambuddy uses 8910
PORT=8910
PUID=1000
PGID=1000
# Generate once with: openssl rand -hex 32
JWT_SECRET_KEY=
# Bambu Studio CLI sidecar (deploy/slicer-api)
SLICER_API_URL=http://localhost:3001
