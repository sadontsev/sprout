# Copy to .env (gitignored) and fill in. `docker compose up -d --build` fails loudly if the
# APNS_* values are missing — better than every push silently 403ing later.

# Your Bambuddy API key. la-push polls Bambuddy with it, and validates the key the APP presents
# against Bambuddy too, so the same key works for both.
#   printf 'BAMBUDDY_API_KEY=%s\n' "$(tr -d '[:space:]' < <secrets-dir>/bb_apikey)" >> .env
BAMBUDDY_API_KEY=

# From YOUR Apple developer account — Certificates, Identifiers & Profiles → Keys → an APNs key.
# These were hardcoded to the original owner's team once; if you use someone else's, APNs answers
# 403 InvalidProviderToken (wrong kid/iss) or 400 TopicDisallowed (wrong topic).
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_TOPIC=com.example.yourapp.push-type.liveactivity

# Where your .p8 lives on the host. Defaults to <secrets-dir>/apns_key.p8.
#APNS_KEY_FILE=/home/you/.config/sprout/apns_key.p8

# Only if your bundle id is NOT APNS_TOPIC minus ".push-type.liveactivity". Leave it OUT rather
# than blank — an empty value defeats the derived default and sends an empty alert topic.
#APNS_BUNDLE_ID=com.example.yourapp

# api.push.apple.com for TestFlight/App Store builds (the default), api.sandbox.push.apple.com for
# local Xcode builds. The wrong one fails silently with BadDeviceToken.
#APNS_HOST=api.push.apple.com

# Bambuddy's docker volume, mounted read-only so the MakerWorld collection endpoints can read the
# stored Bambu Cloud token. The default is the name compose generates for deploy/bambuddy/; check
# yours with:
#   docker inspect bambuddy --format '{{range .Mounts}}{{.Name}}{{end}}'
# Mounting the wrong volume fails SILENTLY — collections just report "can't see Bambuddy's database".
#BAMBUDDY_VOLUME=bambuddy_bambuddy_data
