# Canopy configuration. Copy to .env and fill in. Nothing here is committed.

# --- required ---
# Your bundle id and 10-character Apple team id. These MUST match the build you install: APNs keys
# are team-scoped and the Live Activity topic is derived from the bundle id.
CANOPY_BUNDLE_ID=com.example.yourapp
CANOPY_TEAM_ID=YOURTEAMID
# Key id of the APNs auth key mounted at /keys/apns_key.p8.
CANOPY_APNS_KEY_ID=ABCDE12345

# --- the deploying user ---
# The container writes to ./data as this uid/gid. Set them to `id -u` and `id -g`, and make sure
# ./data exists BEFORE the first start — Docker creates a missing bind source as root, and the
# process then cannot create its database and crash-loops. scripts-deploy.sh handles both.
CANOPY_UID=1000
CANOPY_GID=1000

# --- optional ---
# Gates enrolment. Set it if this relay is reachable from the internet; enrolment is otherwise open.
CANOPY_INVITE_CODE=

# Apple's fraud-assessment metric. A DEVICECHECK key from Certificates, Identifiers & Profiles —
# NOT the APNs key above and NOT an App Store Connect key, though all three download as
# AuthKey_<id>.p8 and are identical on disk. Both go together; unset means the sweep never runs.
CANOPY_DEVICECHECK_KEY_ID=
DEVICECHECK_KEY_FILE=

# Permits Apple's DEVELOPMENT App Attest environment, which locally-installed builds use.
# Turn OFF once only TestFlight and App Store builds talk to this relay.
CANOPY_ALLOW_DEVELOPMENT_ATTEST=1

# Paths to the key and Apple's App Attest root certificate on the host.
APNS_KEY_FILE=${HOME}/.config/sprout/apns_key.p8
APPLE_ROOT_CA_FILE=${HOME}/.config/sprout/apple-app-attest-root.pem
